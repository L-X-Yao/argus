#!/bin/bash
# Pre-commit gate: lint + type-check (fast, <5s).
# Full test suite runs on push — see .githooks/pre-push.
# Install: git config core.hooksPath .githooks
set -e

# Git runs hooks in a non-login shell, which may not have nvm loaded.
command -v npx >/dev/null || { [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh"; }

# A clone can list words that must never be committed, one per line, in
# .git/info/sensitive-words. The list stays out of the repo because writing a
# word here would publish it. No list, no check. Searches the staged content.
_WORDS=$(git rev-parse --git-path info/sensitive-words)
if [ -s "$_WORDS" ]; then
  echo "[pre-commit] sensitive-word check..."
  _HITS=$(git diff --cached --name-only --diff-filter=d -z |
    xargs -0 -r git --literal-pathspecs grep --cached -n -i -F -f "$_WORDS" -- 2>&1 || true)
  if [ -n "$_HITS" ]; then
    echo "ERROR: sensitive-word check failed on staged files"
    echo "$_HITS"
    exit 1
  fi
  _NAMES=$(git diff --cached --name-only --diff-filter=d | grep -i -F -f "$_WORDS" || true)
  if [ -n "$_NAMES" ]; then
    echo "ERROR: sensitive-word check failed on staged file names"
    echo "$_NAMES"
    exit 1
  fi
fi

echo "[pre-commit] i18n error-string check..."
# WS command handlers must use lt() for error messages, not hardcoded English.
# Security-boundary errors in firmware.py/video.py are exempt (HTTP API, no locale).
_BAD=$(git diff --cached --name-only -- 'backend/commands/*.py' | xargs grep -n '"error":\s*"[A-Z]' 2>/dev/null | grep -v 'lt(' | grep -v '# i18n-exempt' || true)
if [ -n "$_BAD" ]; then
  echo "ERROR: hardcoded English error strings in command handlers (use lt()):"
  echo "$_BAD"
  exit 1
fi

echo "[pre-commit] ruff..."
ruff check backend/ scripts/ tests/ --quiet

echo "[pre-commit] svelte-check..."
npx svelte-check --tsconfig ./tsconfig.json 2>&1 | tail -1 | grep -q '0 ERRORS' || {
  echo "svelte-check failed"; exit 1;
}

echo "[pre-commit] OK"
